# sudo cp deploy/kiosk-print.service /etc/systemd/system/
# sudo systemctl daemon-reload && sudo systemctl enable --now kiosk-print
[Unit]
Description=Kiosk Print backend
After=network-online.target cups.service
Wants=network-online.target

[Service]
User=kiosk
WorkingDirectory=/home/kiosk/print-kiosk
Environment=KIOSK_CONFIG=/home/kiosk/print-kiosk/deploy/config.pi.toml
ExecStart=/home/kiosk/print-kiosk/.venv/bin/python -m app.main
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target